# Used by `npm install` in standalone copies of this folder (the "Deploy to
# Cloudflare" button and `npm run setup`). pnpm, used by the monorepo, ignores it.
#
# Don't auto-install optional peer dependencies: vitest's optional peers
# (browser runners, coverage, UI) form a peer set that npm 11 fails to resolve
# ("Cannot read properties of null (reading 'edgesOut')"). Every peer this app
# actually needs is a direct dependency in package.json.
legacy-peer-deps=true
