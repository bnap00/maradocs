# Optional local settings for `npm run dev` (wrangler dev). Nothing here is
# required: open the dashboard and create the first account. To override a
# setting locally:
#
#   cp .dev.vars.example .dev.vars
#
# In production, set secrets with `npx wrangler secret put <NAME>` and plain
# settings as `vars` in wrangler.jsonc — never commit real values.

# Who may create accounts: `first` (default: only the first account, i.e. the
# owner), `open` (anyone) or `closed` (nobody; existing accounts only).
# REGISTRATION=first
#
# Claim password. While no account exists, creating the first one requires
# this value, so nobody else can claim the deployment before you do. Ignored
# once any account exists, and never used to sign in. Left uncommented so the
# Deploy to Cloudflare button asks for it; locally it can stay empty (an empty
# value means no claim password).
ADMIN_PASSWORD=
#
# HMAC key for unlock cookies and report capability tokens. At least 32
# characters (`openssl rand -hex 32`); shorter values are ignored (with a
# warning in the logs) and the secret generated in D1 is used instead.
# COOKIE_SECRET=
#
# External origin used in API responses, e.g. https://docs.example.com
# PUBLIC_BASE_URL=
#
# Serve PDFs inline without the report sandbox (default: download them).
# PDF_INLINE=true
