    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "pino-pretty": "^13.0.0",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/yauzl": "^2.10.3",
    "adm-zip": "^0.5.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
