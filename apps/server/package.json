{
  "name": "@maradocs/server",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"fs.chmodSync('dist/standalone.js', 0o755)\"",
    "dev": "tsx watch --ignore ../../.maradocs-data --ignore ../../data src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx ./test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@maradocs/shared": "workspace:*",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "pino-pretty": "^13.2.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "description": "Self-hosted MaraDocs server: publish static HTML reports from agents/CLI/CI and serve them at durable, access-controlled URLs.",
  "author": "Bharat Parsiya",
  "repository": {
    "type": "git",
    "url": "https://github.com/bnap00/maradocs",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/bnap00/maradocs#readme",
  "keywords": [
    "maradocs",
    "server",
    "publish",
    "reports",
    "agents",
    "ai",
    "html",
    "static",
    "self-hosted"
  ],
  "bin": {
    "maradocs-server": "./dist/standalone.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
