# ---- Core ----
PORT=8787
# Absolute paths are used as-is. Relative paths resolve from the repo root when
# using `pnpm run dev`.
DATA_DIR=/data
# External URL used in publish responses (shareable links). Omit for localhost.
PUBLIC_BASE_URL=http://localhost:8787
# Default access for newly created repositories: public | password | private
DEFAULT_REPO_ACCESS=private
# Per-bundle upload limit in megabytes.
MAX_UPLOAD_MB=50

# ---- Security ----
# Required in production (min 32 chars). Used to sign password-gate cookies.
# Intentionally left empty so `docker compose up` fails loudly until you set
# a real value. Generate with:
#   openssl rand -hex 32
COOKIE_SECRET=

# ---- Authentication ----
# Required. Dashboard admin password. Plain text — hashed with bcrypt at
# startup, never persisted. Intentionally left empty; pick a strong value.
ADMIN_PASSWORD=

# ---- Local development only ----
# Vite dashboard dev server proxied by the API server at /dashboard.
DASHBOARD_DEV_SERVER_URL=http://localhost:5273
