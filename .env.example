# ---- Core ----
PORT=8787
# Absolute paths are used as-is. Relative paths resolve from the repo root when
# using `pnpm run dev`.
DATA_DIR=/data
# External URL used in publish responses (shareable links). Omit for localhost.
PUBLIC_BASE_URL=http://localhost:8787
# Default access for newly created repositories: public | password | private
DEFAULT_REPO_ACCESS=private
# Per-bundle upload limit in megabytes.
MAX_UPLOAD_MB=50

# ---- Security ----
# Optional. Signs password-gate cookies. When unset, a random secret is
# generated on first start and stored in the database. If you set it, use at
# least 32 characters, e.g. `openssl rand -hex 32`.
COOKIE_SECRET=

# ---- Accounts ----
# Sign in with email + password accounts created in the dashboard. Each
# account's repositories, documents, API keys and audit log are private to it.
# Who may create accounts: first (default: only the first visitor, who becomes
# the owner) | open (anyone) | closed (nobody; existing accounts only).
REGISTRATION=first
# Optional claim password. No longer a login: if set while no account exists,
# creating the first account requires entering it. Keep it set when upgrading an
# instance that already has data so a stranger cannot claim it; leave empty on
# fresh installs. Ignored once an account exists.
ADMIN_PASSWORD=

# Which reverse proxies may set X-Forwarded-For (used for client IPs / rate
# limits): comma-separated IPs/CIDRs or loopback|linklocal|uniquelocal, or
# "false". Production default: loopback,linklocal,uniquelocal.
# TRUST_PROXY=

# ---- Local development only ----
# Vite dashboard dev server proxied by the API server at /dashboard.
DASHBOARD_DEV_SERVER_URL=http://localhost:5273
