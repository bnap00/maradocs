# ---- Core ----
PORT=8787
# Absolute paths are used as-is. Relative paths resolve from the repo root when
# using `pnpm run dev`.
DATA_DIR=/data
# External URL used in publish responses (shareable links). Omit for localhost.
PUBLIC_BASE_URL=http://localhost:8787
# Default access for newly created repositories: public | password | private
DEFAULT_REPO_ACCESS=private
# Per-bundle upload limit in megabytes.
MAX_UPLOAD_MB=50

# ---- Security ----
# Required in production. Used to sign password-gate cookies. Generate with:
#   openssl rand -hex 32
COOKIE_SECRET=change-me-to-a-long-random-string

# ---- Authentication ----
# Required. Plain text — hashed with bcrypt at startup, never persisted.
# Change this before exposing the server to the internet.
ADMIN_PASSWORD=change-me-before-exposing-to-internet

# ---- Local development only ----
# Vite dashboard dev server proxied by the API server at /dashboard.
DASHBOARD_DEV_SERVER_URL=http://localhost:5273
